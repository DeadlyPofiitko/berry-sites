---
import Layout from '../layouts/Layout.astro';
import Flex from '../components/Flex';
import Link from '../components/Link.tsx';
---

<Layout title="404 - Page Not Found">
  <Flex align="center" justify="center" h="100vh" direction="column" gap="1.25rem">
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-message">The page you are looking for does not exist or has been moved.</p>
    <Link href="/" className="home-link">Home</Link>
  </Flex>
</Layout>

<style>
  .error-title {
    font-family: "Ronzino-Bold";
    color: var(--main-blue-color);
    font-size: 5rem;
    margin: 0;
    text-align: center;
  }

  .error-message {
    font-family: "Ronzino-Medium";
    color: var(--black-color);
    font-size: 1.5rem;
    margin: 0;
    text-align: center;
    max-width: 32rem;
  }

  .home-link {
    font-family: "Ronzino-Bold";
    color: var(--main-blue-color);
    font-size: 1.25rem;
    text-decoration: underline;
    text-underline-offset: 6px;
    margin-top: 0.5rem;
    transition: color 0.2s ease;
  }

  .home-link:hover {
    color: var(--secondary-blue-color);
  }
</style>
