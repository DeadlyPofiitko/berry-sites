---
import Layout from "../layouts/Layout.astro";
import { getComicsPages } from "../services/pages";
import ComicsList from "../components/ComicsList";
import "../styles/page-style.css";

const { locale = "en", isDomainScoped = false } = Astro.locals;
const comics = await getComicsPages(locale);

---

<Layout title="Comics">
    <div class="page-container">
        <ComicsList comics={comics} locale={locale} isDomainScoped={isDomainScoped} client:load />
    </div>
</Layout>